{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "prisma": "prisma --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:generate": "prisma generate --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:format": "prisma format --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:validate": "prisma validate --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:studio": "prisma studio --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:status": "prisma migrate status --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:migrate:create": "prisma migrate dev --create-only --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:migrate:reset": "prisma migrate reset --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:migrate:resolve": "prisma migrate resolve --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:pull": "prisma db pull --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:push": "prisma db push --config prisma/prisma.config.ts --schema prisma/schema.prisma",
    "db:seed": "prisma db seed --config prisma/prisma.config.ts --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^7.4.1"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "jiti": "^2.6.1",
    "prisma": "^7.4.1"
  }
}
