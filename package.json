{
  "name": "personal-workstation-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "api:dev": "pnpm --filter api dev",
    "web:dev": "pnpm --filter web dev",
    "db:prisma": "pnpm --filter @repo/database prisma",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:migrate:dev": "pnpm --filter @repo/database db:migrate:dev",
    "db:migrate:create": "pnpm --filter @repo/database db:migrate:create",
    "db:migrate:deploy": "pnpm --filter @repo/database db:migrate:deploy",
    "db:migrate:reset": "pnpm --filter @repo/database db:migrate:reset",
    "db:migrate:resolve": "pnpm --filter @repo/database db:migrate:resolve",
    "db:status": "pnpm --filter @repo/database db:status",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:format": "pnpm --filter @repo/database db:format",
    "db:validate": "pnpm --filter @repo/database db:validate",
    "db:studio": "pnpm --filter @repo/database db:studio",
    "db:pull": "pnpm --filter @repo/database db:pull",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:seed": "pnpm --filter @repo/database db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,json,md,css}": [
      "pnpm exec prettier --write"
    ]
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
