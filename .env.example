# .env.example - Root

# DATABASE (Supabase)
DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:pass@host:5432/dbname?schema=public"

# AUTH
NEXTAUTH_SECRET="your_secret_here"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# API AUTH (Nest)
JWT_ACCESS_SECRET="replace-with-strong-secret"
JWT_REFRESH_SECRET="replace-with-strong-secret"
JWT_CHALLENGE_SECRET="replace-with-strong-secret"
JWT_SETUP_SECRET="replace-with-strong-secret"
JWT_ACCESS_EXPIRES_IN="900"
JWT_REFRESH_EXPIRES_IN="2592000"
JWT_CHALLENGE_EXPIRES_IN="300"
JWT_SETUP_EXPIRES_IN="600"
BCRYPT_ROUNDS="12"

# API SECURITY
REDIS_URL="redis://localhost:6379"
FRONTEND_URL="http://localhost:3000"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# OAUTH
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_CALLBACK_URL="http://localhost:3001/api/auth/microsoft/callback"

# DEPLOYMENT
RENDER_API_KEY=""
